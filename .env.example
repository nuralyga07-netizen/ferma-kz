# ===== Backend (Go) =====
PORT=8080
DATABASE_URL=postgres://ferma:ferma@localhost:5432/ferma?sslmode=disable
JWT_SECRET=change-me-to-a-random-32-bytes-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./storage/uploads

# Бизнес-константы
DELIVERY_FEE=500
DELIVERY_FREE_FROM=10000
REFERRAL_REWARD=500

# Админ (создаётся миграцией-seed)
ADMIN_EMAIL=admin@ferma.kz
ADMIN_PASSWORD=admin123

# ===== Postgres (docker-compose) =====
POSTGRES_USER=ferma
POSTGRES_PASSWORD=ferma
POSTGRES_DB=ferma

# ===== Frontend (Vite dev) =====
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
